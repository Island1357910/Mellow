{
  "name": "mellow",
  "private": true,
  "version": "1.0.6",
  "description": "半糖 · Mellow，一台纯前端的 AI 角色小手机",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:pages": "powershell -ExecutionPolicy Bypass -File scripts/deploy-pages.ps1",
    "check:upgrade": "node --import ./scripts/check-env.mjs scripts/check-upgrade.ts",
    "check:earnings": "node --import ./scripts/check-env.mjs scripts/check-earnings.ts",
    "check:release": "node --import ./scripts/check-env.mjs scripts/check-release.ts",
    "check:sms": "node --import ./scripts/check-env.mjs scripts/check-sms.ts",
    "check:together": "node --import ./scripts/check-env.mjs scripts/check-together.ts",
    "check:mcp": "node --import ./scripts/check-env.mjs scripts/check-mcp.ts",
    "check:netease": "node --import ./scripts/check-env.mjs scripts/check-netease.ts",
    "check:direct": "node --import ./scripts/check-env.mjs scripts/check-direct.ts",
    "check:connections": "node scripts/check-connection-tabs.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "dexie": "^4.2.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.545.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
