{
  "name": "mellow",
  "private": true,
  "version": "1.1.38",
  "description": "半糖 · Mellow，一台纯前端的 AI 角色小手机",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:pages": "powershell -ExecutionPolicy Bypass -File scripts/deploy-pages.ps1",
    "check:upgrade": "node --import ./scripts/check-env.mjs scripts/check-upgrade.ts",
    "check:earnings": "node --import ./scripts/check-env.mjs scripts/check-earnings.ts",
    "check:release": "node --import ./scripts/check-env.mjs scripts/check-release.ts",
    "check:sms": "node --import ./scripts/check-env.mjs scripts/check-sms.ts",
    "check:together": "node --import ./scripts/check-env.mjs scripts/check-together.ts",
    "check:mcp": "node --import ./scripts/check-env.mjs scripts/check-mcp.ts",
    "check:netease": "node --import ./scripts/check-env.mjs scripts/check-netease.ts",
    "check:direct": "node --import ./scripts/check-env.mjs scripts/check-direct.ts",
    "check:shared-life": "node --import ./scripts/check-env.mjs --import ./scripts/check-transaction-scope.mjs scripts/check-shared-life.ts",
    "check:interactions": "node --import ./scripts/check-env.mjs --import ./scripts/check-transaction-scope.mjs scripts/check-interactions.ts",
    "check:table-input": "node --import ./scripts/check-env.mjs scripts/check-table-input.ts",
    "check:connections": "node scripts/check-connection-tabs.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "check:wallpaper": "node --import ./scripts/check-env.mjs scripts/check-wallpaper.ts",
    "check:worldforge": "node --import ./scripts/check-env.mjs scripts/check-worldforge.ts",
    "check:api-routing": "node --import ./scripts/check-env.mjs --import ./scripts/check-transaction-scope.mjs scripts/check-api-routing.ts",
    "check:reasoning": "node --import ./scripts/check-env.mjs scripts/check-reasoning.ts",
    "check:proactive-api": "node --import ./scripts/check-env.mjs scripts/check-proactive-api.ts",
    "check:db-startup": "node --import ./scripts/check-env.mjs scripts/check-db-startup.ts",
    "check:table-history": "node --import ./scripts/check-env.mjs --import ./scripts/check-transaction-scope.mjs scripts/check-table-history.ts",
    "check:petal": "node scripts/check-petal.ts",
    "check:generation": "node --import ./scripts/check-env.mjs scripts/check-generation.ts",
    "check:chat-memory": "node --import ./scripts/check-env.mjs --import ./scripts/check-transaction-scope.mjs scripts/check-chat-memory.ts",
    "check:channel-delivery": "node --import ./scripts/check-env.mjs --import ./scripts/check-transaction-scope.mjs scripts/check-channel-delivery.ts",
    "check:story-continuity": "node --import ./scripts/check-env.mjs --import ./scripts/check-transaction-scope.mjs scripts/check-story-continuity.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "abort-controller": "^3.0.0",
    "core-js": "^3.51.0",
    "dexie": "^4.2.1",
    "framer-motion": "^12.23.22",
    "jsbi": "^4.3.2",
    "lucide-react": "^0.545.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resize-observer-polyfill": "^1.5.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@csstools/postcss-cascade-layers": "^6.0.2",
    "@csstools/postcss-color-mix-function": "^4.0.16",
    "@csstools/postcss-oklab-function": "^5.0.16",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.19.0",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.32",
    "postcss-logical": "^9.0.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
