<view class="page">
  <view class="card">
    <input placeholder="搜索名字、标签" value="{{query}}" bindinput="onQueryInput" confirm-type="search" />
  </view>

  <view wx:if="{{loading}}" class="muted card">加载中…</view>
  <view wx:elif="{{error}}" class="card error-box">{{error}}</view>
  <view wx:elif="{{filtered.length === 0}}" class="card muted">还没有卡片</view>

  <block wx:for="{{filtered}}" wx:key="id">
    <view class="card row" bindtap="openCard" data-id="{{item.id}}">
      <image wx:if="{{item.coverUrl}}" class="cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view wx:else class="cover placeholder">🎴</view>
      <view class="info">
        <view class="title">{{item.name}}</view>
        <view class="muted summary">{{item.summary}}</view>
        <view>
          <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
