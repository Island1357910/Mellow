# The exact HTTPS origin of the static frontend (no path).
FRONTEND_ORIGIN=https://mymellow.top
# Supply the SMTP credentials from the provider. Percent-encode credentials in the URL.
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
MAIL_FROM=workshop@mymellow.top
# 64 hex characters from: openssl rand -hex 32
WORKSHOP_CONTENT_KEY=
# Replace with ALL public IPv4 addresses of this VPS and other infrastructure
# that this service must never call. Production requires a value.
BLOCKED_UPSTREAM_IPS=
WORKSHOP_HOST_PORT=18787
# Optional. Use an approved provider to test complete, non-public review drafts.
# WORKSHOP_REVIEW_ENDPOINT=https://example.com/v1/chat/completions
# WORKSHOP_REVIEW_MODEL=
# WORKSHOP_REVIEW_KEY=
# Legacy clients only. Updated clients supply the player's selected API per request.
# WORKSHOP_PLAY_ENDPOINT=https://example.com/v1/chat/completions
# WORKSHOP_PLAY_MODEL=
# WORKSHOP_PLAY_KEY=
